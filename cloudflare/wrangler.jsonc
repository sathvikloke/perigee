{
  // Perigee: Cloudflare Workers static assets + API router (cloudflare/src/index.js).
  // Build cloudflare/build/ first: see docs/CLOUDFLARE.md. account_id and any
  // routes/custom domains are added by the deployment owner, not committed here.
  "name": "perigee",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  // Public URL: https://perigee.<account workers.dev subdomain>.workers.dev.
  // Preview (version) URLs stay off so unreleased versions are never public.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
