{"id":"sh/2dgbedgr","kind":"textbox","position":{"left":48,"top":203,"width":620,"height":114},"text":"The activity starts with a visible change. The student tests an interpretation and leaves with their own conclusion, supported by named observations.","style":{"fontSize":24,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
