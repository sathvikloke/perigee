{"id":"sh/nitcv254","kind":"textbox","position":{"left":48,"top":26,"width":1140,"height":26},"text":"PERIGEE   /   NASA DATA & IMPLEMENTATION","style":{"fontSize":17,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/0f2tk76d","kind":"textbox","position":{"left":48,"top":65,"width":1184,"height":66},"text":"How archive files become a usable investigation","style":{"fontSize":42,"typeface":"Avenir Next","color":"#F5F6F5","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/lgbatcny","kind":"shape","position":{"left":48,"top":678,"width":1184,"height":1},"geometry":"rect","fillColor":"#343B3B","lineWidth":0},
{"id":"sh/3a9c32p0","kind":"textbox","position":{"left":48,"top":691,"width":1010,"height":19},"text":"NASA Space Apps 2026 · Planet X and SPHEREx","style":{"fontSize":14,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/290vux8f","kind":"textbox","position":{"left":1168,"top":689,"width":70,"height":23},"text":"4 / 7","style":{"fontSize":16,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/pcru5s76","kind":"textbox","position":{"left":48,"top":159,"width":350,"height":43},"text":"1  Retrieve the data","style":{"fontSize":27,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/4bidw7ql","kind":"textbox","position":{"left":48,"top":218,"width":350,"height":246},"text":"NASA/IPAC’s Infrared Science Archive (IRSA) provides SPHEREx Level 2 observations from Data Release 1 and Quick Release 3. We retrieve small FITS cutouts: scientific files containing pixels, observation times, wavelength information and quality flags.","style":{"fontSize":23,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/betc72pw","kind":"shape","position":{"left":48,"top":477,"width":350,"height":1},"geometry":"rect","fillColor":"#343B3B","lineWidth":0},
{"id":"sh/qdkvyx8b","kind":"textbox","position":{"left":48,"top":498,"width":350,"height":138},"text":"Object names resolve through SIMBAD/Sesame. Search also accepts decimal or sexagesimal sky coordinates, such as hours:minutes:seconds.","style":{"fontSize":22,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/dgbu9c72","kind":"textbox","position":{"left":455,"top":159,"width":350,"height":43},"text":"2  Process consistently","style":{"fontSize":27,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/cf2d07qh","kind":"textbox","position":{"left":455,"top":218,"width":350,"height":246},"text":"Python uses each file’s sky coordinates to place observations on one fixed, north-up grid. It reads the wavelength at the target’s detector position, converts pixel values into a stated display contrast, and preserves quality information.","style":{"fontSize":23,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/zitcbmp8","kind":"shape","position":{"left":455,"top":477,"width":350,"height":1},"geometry":"rect","fillColor":"#343B3B","lineWidth":0},
{"id":"sh/yhkv2h8n","kind":"textbox","position":{"left":455,"top":498,"width":350,"height":138},"text":"Display contrast maps measurements to gray; different scales can make the same value look different. The target marker is a catalog prediction.","style":{"fontSize":22,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/adofalsv","kind":"textbox","position":{"left":862,"top":159,"width":370,"height":43},"text":"3  Deliver in the browser","style":{"fontSize":27,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/vexg3q9g","kind":"textbox","position":{"left":862,"top":218,"width":370,"height":246},"text":"React and TypeScript provide comparison playback, optional flag overlays, guided checks and the notebook. Cloudflare serves the app and prepared cases; a Python/FastAPI service on Vercel handles live archive requests.","style":{"fontSize":23,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/wz6xcva1","kind":"shape","position":{"left":862,"top":477,"width":370,"height":1},"geometry":"rect","fillColor":"#343B3B","lineWidth":0},
{"id":"sh/x0fy5gr6","kind":"textbox","position":{"left":862,"top":498,"width":370,"height":138},"text":"Two frame requests run at once, with bounded retries and a cache of completed results. The first ready image is usable while others load.","style":{"fontSize":22,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/m94f61sj","kind":"textbox","position":{"left":48,"top":649,"width":1184,"height":24},"text":"NASA/IPAC IRSA: irsa.ipac.caltech.edu/Missions/spherex.html · SIMBAD: target context · ESA Gaia DR3: independent field-star checks","style":{"fontSize":14,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0}
]}
