{"id":"sh/kf25s32p","kind":"textbox","position":{"left":48,"top":691,"width":1010,"height":19},"text":"NASA Space Apps 2026 · Planet X and SPHEREx","style":{"fontSize":14,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/lgvml83a","kind":"textbox","position":{"left":1168,"top":689,"width":70,"height":23},"text":"3 / 7","style":{"fontSize":16,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ydknqtkj","kind":"textbox","position":{"left":48,"top":145,"width":1184,"height":67},"text":"Wavelength is the “color” of infrared light, measured here in micrometers (µm). Problem flags mark pixels the mission pipeline considers unreliable.","style":{"fontSize":23,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"im/cj2xoby9","kind":"image","position":{"left":48,"top":235,"width":96,"height":96},"fit":"contain","alt":"Barnard’s Star first SPHEREx image"},
{"id":"im/zmdgzqx0","kind":"image","position":{"left":154,"top":235,"width":96,"height":96},"fit":"contain","alt":"Barnard’s Star second SPHEREx image"},
{"id":"sh/xcbmho3y","kind":"textbox","position":{"left":48,"top":339,"width":230,"height":31},"text":"25 Aug 2025 / 19 Aug 2026","style":{"fontSize":13,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/a9knmtkn","kind":"textbox","position":{"left":287,"top":235,"width":945,"height":36},"text":"Barnard’s Star · Can you see a star move?","style":{"fontSize":26,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/bat4fyls","kind":"textbox","position":{"left":287,"top":278,"width":945,"height":94},"text":"Across a year near 2.0 µm, the glow shifts north while field stars stay nearly fixed. This agrees with the predicted motion. The bright core overloads the detector, limiting its exact image position.","style":{"fontSize":22.51,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"im/nqdg3qxw","kind":"image","position":{"left":48,"top":376,"width":96,"height":96},"fit":"contain","alt":"Epsilon Indi B first SPHEREx image"},
{"id":"im/mp4fulgb","kind":"image","position":{"left":154,"top":376,"width":96,"height":96},"fit":"contain","alt":"Epsilon Indi B second SPHEREx image"},
{"id":"sh/re1gfq9g","kind":"textbox","position":{"left":48,"top":480,"width":230,"height":31},"text":"Same exposure · 29 Apr 2026","style":{"fontSize":13,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/qdsz6l8b","kind":"textbox","position":{"left":287,"top":376,"width":945,"height":36},"text":"Epsilon Indi B · Is this a fair comparison?","style":{"fontSize":26,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/dgjyhgrm","kind":"textbox","position":{"left":287,"top":419,"width":945,"height":94},"text":"One pair compares dates five months apart near 2.323 µm. Another compares 2.3232 and 4.9399 µm at the same moment. The latter tests wavelength, not time. The learner also checks display contrast before interpreting a difference in gray level.","style":{"fontSize":22.51,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"im/jexwbqd4","kind":"image","position":{"left":48,"top":517,"width":96,"height":96},"fit":"contain","alt":"WISE 0855 field first SPHEREx image"},
{"id":"im/wrmdgvet","kind":"image","position":{"left":154,"top":517,"width":96,"height":96},"fit":"contain","alt":"WISE 0855 field second SPHEREx image"},
{"id":"sh/ehszal87","kind":"textbox","position":{"left":48,"top":621,"width":230,"height":31},"text":"7 Nov 2025 / 10 Nov 2025","style":{"fontSize":13,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/1k3il07y","kind":"textbox","position":{"left":287,"top":517,"width":945,"height":36},"text":"WISE 0855 field · A dot that jumps","style":{"fontSize":26,"typeface":"Avenir Next","color":"#D7FC70","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/0jahcvqd","kind":"textbox","position":{"left":287,"top":560,"width":945,"height":94},"text":"A bright dot appears to jump over three days at closely matched wavelength. The quality overlay identifies the unreliable feature. The learner can explain why this apparent jump is insufficient evidence for a moving celestial object.","style":{"fontSize":22.51,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0}
]}
