{"id":"sh/0zm5cfyh","kind":"textbox","position":{"left":48,"top":65,"width":1184,"height":66},"text":"Each case teaches a different comparison","style":{"fontSize":42,"typeface":"Avenir Next","color":"#F5F6F5","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
