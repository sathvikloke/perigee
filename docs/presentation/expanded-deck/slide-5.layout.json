{"id":"sh/7y1kj65c","kind":"textbox","position":{"left":48,"top":355,"width":1184,"height":41},"text":"Adverse mission flags support the check. The feature’s physical cause remains unknown.","style":{"fontSize":23,"typeface":"Avenir Next","color":"#AFB6BA","alignment":"left"},"geometry":"rect","lineWidth":0},
