{"id":"sh/kn6hk7yx","kind":"textbox","position":{"left":671,"top":493,"width":561,"height":112},"text":"Independent Gaia field-star alignment checks cover the 183 unique cutouts. UNKNOWN means too few usable stars. Alignment verdicts do not certify source identity.","style":{"fontSize":22.51,"typeface":"Avenir Next","color":"#F5F6F5","alignment":"left"},"geometry":"rect","lineWidth":0},
