  "narrative": {
    "northStar": "The Classroom Experiment Bench",
    "overview": "The classroom experiment bench gives learners a calm place to compare observations and make their reasoning visible. Cool paper, rounded white containers and substantial navy headings surround the scientific imagery. Cobalt identifies actions and selection; a lavender notebook distinguishes writing from observation.\n\nThis system is extracted from the interactive local prototype in `design/prototype/`, not a live archive application. Registered sky plates and their adjacent metadata establish the evidence; interface decoration does not supply astronomical content. The prototype’s compact density supports both inspection and writing without hiding uncertainty.",
    "keyCharacteristics": [
      "Equal-scale, registered observation plates with nearby metadata.",
      "Rounded paper surfaces, flat depth and a lavender evidence notebook.",
      "Plain language, visible keyboard focus and readable scientific labels."
    ],
    "rules": [
      {
        "name": "The Evidence Travels Together Rule",
        "body": "Keep the image, date, wavelength, quality status and source associated when the selected observation changes.",
        "section": "colors"
      },
      {
        "name": "The Readable Metadata Rule",
        "body": "Screen metadata stays at least 12px; notebook text entry becomes 16px at the stacked layout breakpoint.",
        "section": "typography"
      },
      {
        "name": "The Paper Surface Rule",
        "body": "Use borders and background changes for container depth; reserve image-overlay shadows for legibility.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep date and wavelength separate and visible beside each observation.",
      "Do preserve notes and selected evidence across comparison changes.",
      "Do use explicit pressed states, text status labels and visible focus.",
      "Do recompose to one manually selectable plate on narrow phones."
    ],
    "donts": [
      "Don’t use generated sky imagery as observational evidence.",
      "Don’t turn a catalog prediction or passed flag screen into a detection claim.",
      "Don’t reduce screen labels below 12px to fit the layout.",
      "Don’t describe this local prototype as live coordinate search."
    ]
  }
}
